@using DataAccessObject.Models
@model IEnumerable<Table>
@using Ultitity.Extensions
@{
    ViewBag.Title = "Danh sách bàn Bida";
    var playingTimes = ViewBag.PlayingTimes as Dictionary<Guid, DateTime?>;
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary mb-2">Danh sách Bàn Bida</h2>
        <p class="text-muted">Chọn bàn phù hợp để bắt đầu trải nghiệm</p>

        <!-- Nút thêm bàn -->
        <a asp-action="AddTable" class="btn btn-success mt-3 px-4 fw-semibold">
            <i class="bi bi-plus-lg me-2"></i>Thêm Bàn
        </a>
    </div>

    <div class="row g-4">
        @if (Model == null || !Model.Any())
        {
            <p class="text-center text-muted">Không có bàn nào!</p>
        }
        else
        {
            foreach (var item in Model)
            {
                string badgeColor = item.Status switch
                {
                    TableStatus.Empty => "bg-secondary",
                    TableStatus.Playing => "bg-success",
                    TableStatus.WaitingPayment => "bg-warning",
                    _ => "bg-secondary"
                };
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                    <div class="card billiard-table shadow-sm h-100 position-relative">

                        <!-- Icon chỉnh sửa -->
                        <a href="/Table/EditTable/@item.TableID" class="btn btn-sm btn-light edit-btn shadow-sm">
                            <i class="fas fa-edit"></i>
                        </a>

                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div class="text-center mb-2">
                                <h5 class="card-title fw-bold text-dark mb-2">@item.TableName</h5>
                                <div class="status-badge">
                                    <span class="badge @badgeColor rounded-pill px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>@item.Status.GetDisplayName()
                                    </span>
                                </div>
                                <p class="text-muted mt-1">
                                    <i class="bi bi-clock-history me-1"></i>
                                    <span id="timer-@item.TableID">
                                        @if (item.Status == TableStatus.Playing && playingTimes!.ContainsKey(item.TableID))
                                        {
                                            @:"0 phút (0h00)"
                                        }
                                    </span>
                                </p>
                            </div>
                            @if(item.Status == TableStatus.Playing || item.Status == TableStatus.WaitingPayment)
                            {
                                <a asp-action="Detail" asp-controller="TableSession" asp-route-tableId="@item.TableID" class="btn btn-primary w-100 py-2 fw-semibold">
                                    <i class="bi bi-cursor-fill me-2"></i>Xem chi tiết
                                </a>
                            }
                            else
                            {
                                <a asp-action="CreateTableSession" asp-controller="TableSession" asp-route-tableId="@item.TableID" class="btn btn-primary w-100 py-2 fw-semibold">
                                    <i class="bi bi-cursor-fill me-2"></i>Chọn bàn
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }      
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .billiard-table {
        border: none;
        border-radius: 15px;
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
        transition: all 0.3s ease;
        border-left: 4px solid #0d6efd;
    }

        .billiard-table:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(13, 110, 253, 0.2) !important;
            border-left-color: #0a58ca;
        }

        .billiard-table .card-body {
            position: relative;
        }

    .table-icon {
        transition: transform 0.3s ease;
    }

    .billiard-table:hover .table-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #0a58ca 0%, #084298 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(13, 110, 253, 0.3);
    }

    .status-badge .badge {
        font-size: 0.875rem;
        font-weight: 500;
    }

    h2.text-primary {
        color: #0d6efd !important;
        font-size: 2.5rem;
    }

    .text-muted {
        color: #6c757d !important;
        font-size: 1.1rem;
    }

    .table-icon svg {
        width: 40px;
        height: 40px;
    }

    .edit-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #0d6efd;
        transition: 0.2s;
        z-index: 10;
    }

        .edit-btn:hover {
            background-color: #e7f1ff;
            color: #0a58ca;
            transform: scale(1.1);
        }
</style>
<script>
    const timers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(playingTimes));

    Object.keys(timers).forEach(id => {
        const startTime = new Date(timers[id]);

        function updateTimer() {
            const now = new Date();
            let diff = Math.floor((now - startTime) / 60000); // tổng phút
            let hours = Math.floor(diff / 60);
            let minutes = diff % 60;
            document.getElementById('timer-' + id).innerText = `${diff} phút (${hours}h${minutes.toString().padStart(2,'0')})`;
        }

        updateTimer(); // update ngay khi load
        setInterval(updateTimer, 60000); // update mỗi phút
    });
</script>